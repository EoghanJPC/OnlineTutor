<div class="container mt-5">
    <div class="card shadow">
        <div class="card-body text-center">
            <h2 class="card-title">Supporting Tutors</h2>
            <hr />

            <form asp-action="CreateDonation" method="POST">
                <div class="btn-group mb-4" role="group">
                    <button type="submit" name="amount" value="5" class="btn btn-outline-primary">Donate €5</button>
                    <button type="submit" name="amount" value="10" class="btn btn-outline-primary">Donate €10</button>
                    <button type="submit" name="amount" value="20" class="btn btn-outline-primary">Donate €20</button>
                </div>

                <div class="mt-3">
                    <label>Or enter a custom amount (€):</label>
                    <input type="number" name="amount" class="form-control d-inline-block w-25" min="1" value="15" />
                    <button type="submit" class="btn btn-success">Donate Now</button>
                </div>
            </form>
        </div>
    </div>
</div>
