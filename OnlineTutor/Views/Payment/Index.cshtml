<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden mb-5">
                <div class="card-header bg-primary text-white text-center py-4">
                    <i class="bi bi-heart-fill fs-1 mb-2"></i>
                    <h2 class="fw-bold">Support Quality Education</h2>
                    <p class="mb-0">Your contributions keep tutoring free for students in need.</p>
                </div>
                <div class="card-body p-5 text-center">
                    <form asp-action="CreateDonation" method="POST">
                        <label class="form-label fw-bold fs-5 mb-3">Choose a donation amount:</label>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <button type="submit" name="amount" value="5" class="btn btn-outline-primary btn-lg w-100 py-3 rounded-pill">€5</button>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" name="amount" value="10" class="btn btn-outline-primary btn-lg w-100 py-3 rounded-pill">€10</button>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" name="amount" value="20" class="btn btn-outline-primary btn-lg w-100 py-3 rounded-pill">€20</button>
                            </div>
                        </div>

                        <div class="input-group mb-4 mx-auto" style="max-width: 400px;">
                            <span class="input-group-text bg-white border-end-0">€</span>
                            <input type="number" name="amount" class="form-control form-control-lg border-start-0" min="1" placeholder="Custom Amount" value="15" />
                            <button type="submit" class="btn btn-success btn-lg px-4">Donate Now</button>
                        </div>
                    </form>
                    <p class="text-muted small">Secure payment processed via Stripe.</p>
                </div>
            </div>

            <div class="row text-center mt-5">
                <div class="col-12 mb-4">
                    <h3 class="fw-bold">How your donation helps</h3>
                    <div class="accent-line mx-auto"></div>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-book text-primary fs-1"></i>
                    <h5 class="mt-3 fw-bold">Resources</h5>
                    <p class="text-muted small">Funding for free textbooks and digital learning materials.</p>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-cpu text-primary fs-1"></i>
                    <h5 class="mt-3 fw-bold">Technology</h5>
                    <p class="text-muted small">Maintaining the platform and servers for 24/7 access.</p>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-people text-primary fs-1"></i>
                    <h5 class="mt-3 fw-bold">Outreach</h5>
                    <p class="text-muted small">Connecting tutors with students in underfunded regions.</p>
                </div>
            </div>
        </div>
    </div>
</div>