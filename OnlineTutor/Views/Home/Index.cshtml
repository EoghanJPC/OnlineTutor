@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-5">
    <div class="row align-items-center mb-5 min-vh-75">
        <div class="col-lg-6">
            <h1 class="display-3 fw-bold text-primary mb-3">Empowering Education for All</h1>
            <p class="lead mb-4 opacity-75">
                We are committed to <strong>Sustainable Development Goal 4</strong>: Ensuring inclusive and equitable quality education for everyone.
            </p>
            <div class="d-flex gap-3">
                <a asp-controller="Tutors" asp-action="Index" class="btn btn-primary btn-lg px-4 shadow rounded-pill">Find a Tutor</a>
                <a asp-controller="Sessions" asp-action="Index" class="btn btn-outline-primary btn-lg px-4 rounded-pill">Browse Sessions</a>
            </div>
        </div>
        
        <div class="col-lg-6 d-flex justify-content-center align-items-center mt-5 mt-lg-0">
            <div class="hero-graphic-wrapper">
                <div class="hero-circle-accent shadow-lg"></div>
                <i class="bi bi-mortarboard-fill hero-icon-glyph"></i>
            </div>
        </div>
    </div>

    <div class="row text-center mt-5 g-4">
        <div class="col-md-4">
            <div class="p-4 border-0 rounded-4 card shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-person-check text-success fs-1"></i>
                    <h3 class="mt-3 fw-bold">Expert Tutors</h3>
                    <p class="text-muted">Learn from vetted professionals across multiple subjects.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 border-0 rounded-4 card shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-globe text-info fs-1"></i>
                    <h3 class="mt-3 fw-bold">Accessible</h3>
                    <p class="text-muted">Join from anywhere in the world, at any time.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 border-0 rounded-4 card shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-heart text-danger fs-1"></i>
                    <h3 class="mt-3 fw-bold">Free Learning</h3>
                    <p class="text-muted">Education is a right, not a privilege. Supported by community tips.</p>
                </div>
            </div>
        </div>
    </div>
</div>
