@model IEnumerable<OnlineTutor.DTOs.SubjectDTO>

@{
    ViewData["Title"] = "Subjects";
}

<h1>Subjects</h1>

<div class="alert alert-info italic">
    <i class="bi bi-quote"></i> "@ViewBag.Quote" — <strong>@ViewBag.Author</strong>
</div>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SubjectName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SubjectName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.SubjectId" class="btn btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.SubjectId" class="btn btn-danger">Delete</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>
