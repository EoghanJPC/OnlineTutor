@model IEnumerable<OnlineTutor.DTOs.SubjectDTO>

@{
    ViewData["Title"] = "Subjects";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-0">Explore Subjects</h1>
            <p class="text-muted">Find the right path for your learning journey.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
                <i class="bi bi-plus-circle-fill me-2"></i>New Subject
            </a>
        }
    </div>

    <div class="card border-0 shadow-sm mb-5" style="border-left: 5px solid #78C2AD !important; background-color: #f8fdfb;">
        <div class="card-body py-4">
            <div class="d-flex">
                <i class="bi bi-quote fs-1 text-primary me-3"></i>
                <div>
                    <p class="fs-5 fw-light italic mb-1">"@ViewBag.Quote"</p>
                    <footer class="blockquote-footer mt-1">@ViewBag.Author</footer>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-12 mb-3">
                <div class="card subject-card-horizontal shadow-sm border-0 p-3">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="icon-box shadow-sm">
                                <i class="bi bi-journal-bookmark-fill fs-3"></i>
                            </div>
                        </div>

                        <div class="col">
                            <h5 class="fw-bold mb-1 text-dark">@item.SubjectName</h5>
                            <p class="text-muted mb-0 small">@item.Description</p>
                        </div>

                        <div class="col-auto">
                            <div class="d-flex align-items-center">
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="me-3">
                                        <a asp-action="Edit" asp-route-id="@item.SubjectId" class="btn btn-warning btn-sm me-1" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.SubjectId" class="btn btn-danger btn-sm" title="Delete">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                }
                                <a asp-controller="Tutors" asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                    View Tutors <i class="bi bi-arrow-right-short"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>