@model OnlineTutor.Models.Session

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Session</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SessionId" />
            <div class="form-group">
                <label asp-for="SessionTime" class="control-label"></label>
                <input asp-for="SessionTime" class="form-control" />
                <span asp-validation-for="SessionTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TutorId" class="control-label"></label>
                <select asp-for="TutorId" class="form-control" asp-items="ViewBag.TutorId"></select>
                <span asp-validation-for="TutorId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="MeetingLink" class="control-label fw-bold"></label>
                <input asp-for="MeetingLink" class="form-control" placeholder="https://zoom.us/j/..." />
                <span asp-validation-for="MeetingLink" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="StudyNotes" class="control-label fw-bold"></label>
                <textarea asp-for="StudyNotes" class="form-control" rows="4" placeholder="Enter session summaries, key points, or links here..."></textarea>
                <span asp-validation-for="StudyNotes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
