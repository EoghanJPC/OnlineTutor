@model IEnumerable<OnlineTutor.DTOs.SessionDTO>

@{
    ViewData["Title"] = "Sessions";
}

<h1>Index</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                Date & Time
            </th>
            <th>
                Tutor
            </th>
            <th>
                Subject
            </th>
            <th>
                Meeting Link
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FormattedTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TutorName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SubjectName)
            </td>
            <td>
                <a href="@item.MeetingLink" target="_blank">Join Session</a>
            </td>
            <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.SessionId" class="btn btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.SessionId" class="btn btn-danger">Delete</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>