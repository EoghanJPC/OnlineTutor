@model IEnumerable<OnlineTutor.DTOs.SessionDTO>

@{
    ViewData["Title"] = "Sessions";
}

<div class="alert alert-info italic">
    <i class="bi bi-quote"></i> "@ViewBag.Quote" — <strong>@ViewBag.Author</strong>
</div>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Upcoming Sessions</h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">Schedule New Session</a>
        }
    </div>

    <div class="italic-quote shadow-sm mb-5">
        <i class="bi bi-calendar-check text-primary fs-3 me-2"></i>
        @ViewBag.Quote — <strong>@ViewBag.Author</strong>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-12 mb-3">
                <div class="card session-card shadow-sm p-3">
                    <div class="row align-items-center text-center text-md-start">
                        
                        <div class="col-md-2 mb-2 mb-md-0">
                            <div class="session-time-box">
                                <span class="d-block fw-bold text-primary">@item.FormattedTime</span>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <h5 class="mb-1 fw-bold">@item.SubjectName</h5>
                            <p class="text-muted mb-0">
                                <i class="bi bi-person-circle me-1"></i> Tutor: <strong>@item.TutorName</strong>
                            </p>
                        </div>

                        <div class="col-md-3">
                            <a href="@item.MeetingLink" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-4">
                                <i class="bi bi-camera-video me-1"></i> Join Session
                            </a>
                        </div>

                        <div class="col-md-2 text-md-end">
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.SessionId" class="btn btn-link text-warning p-1">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.SessionId" class="btn btn-link text-danger p-1">
                                        <i class="bi bi-trash-fill fs-5"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>