@model OnlineTutor.Models.Session

@{
    ViewData["Title"] = "Cancel Session";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="text-center mb-4">
                <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <span class="fs-3">&excl;</span>
                </div>
                <h2 class="h4 fw-bold text-body">Cancel Session?</h2>
                <p class="text-muted small">Are you sure you want to cancel and delete this session? This action cannot be undone.</p>
            </div>

            <div class="card shadow-sm border-0 bg-body-tertiary mb-4">
                <div class="card-body p-4">
                    <h5 class="text-muted small text-uppercase fw-bold mb-3">Session Information</h5>
                    
                    <div class="mb-3">
                        <span class="text-secondary small d-block">Scheduled Time</span>
                        <strong class="text-body fs-5">@Html.DisplayFor(model => model.SessionTime)</strong>
                    </div>

                    <div>
                        <span class="text-secondary small d-block">Assigned Tutor</span>
                        <span class="text-body">@Html.DisplayFor(model => model.Tutor.TutorName)</span>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" class="d-flex flex-column gap-2">
                
                <input type="hidden" asp-for="SessionId" />

                <button type="submit" class="btn btn-danger py-2.5 fw-semibold w-100">
                    Yes, Cancel Session
                </button>
                
                <a asp-action="Index" class="btn btn-outline-secondary py-2.5 fw-semibold w-100">
                    Keep Session and Go Back
                </a>
            </form>

        </div>
    </div>
</div>