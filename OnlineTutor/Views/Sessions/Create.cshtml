@model OnlineTutor.Models.Session

@{
    ViewData["Title"] = "Create Session";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-4 text-secondary">
                <i class="bi bi-arrow-left"></i> &larr; Back to List
            </a>

            <div class="card shadow-sm border-0 bg-body-tertiary">
                <div class="card-body p-4 p-md-5">
                    <h2 class="h4 fw-bold mb-1 text-body">Schedule Session</h2>
                    <p class="text-muted small mb-4">Set up a new tutoring session and meeting link.</p>

                    <form asp-action="Create">
                        
                        <div asp-validation-summary="All" class="text-danger small mb-3 fw-semibold"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="SessionTime" class="form-control" />
                                    <label asp-for="SessionTime" class="text-muted"></label>
                                    <span asp-validation-for="SessionTime" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <select asp-for="TutorId" class="form-select" asp-items="ViewBag.TutorId"></select>
                                    <label asp-for="TutorId" class="text-muted">Tutor</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="MeetingLink" class="form-control" placeholder="https://zoom.us/j/..." />
                            <label asp-for="MeetingLink" class="text-muted">Meeting Link</label>
                            <span asp-validation-for="MeetingLink" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="StudyNotes" class="form-control" style="height: 120px" placeholder="Enter session summaries, key points, or links here..."></textarea>
                            <label asp-for="StudyNotes" class="text-muted">Study Notes</label>
                            <span asp-validation-for="StudyNotes" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary py-2.5 fw-semibold">
                                Schedule Session
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
