@model IEnumerable<OnlineTutor.DTOs.TutorDTO>

@{
    ViewData["Title"] = "Tutors";
}

<div class="alert alert-info italic">
    <i class="bi bi-quote"></i> "@ViewBag.Quote" — <strong>@ViewBag.Author</strong>
</div>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 class="fw-bold">Our Tutors</h1>
            <div class="italic-quote shadow-sm mb-3">
                <i class="bi bi-quote fs-4 text-primary"></i>
                @ViewBag.Quote — <strong>@ViewBag.Author</strong>
            </div>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary mb-3">Add New Tutor</a>
        }
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 col-sm-6 mb-4">
                <div class="card h-100 shadow-sm tutor-card border">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <span class="fs-2">@item.TutorName.Substring(0, 1)</span>
                        </div>
                        
                        <h4 class="card-title fw-bold">@item.TutorName</h4>
                        <span class="subject-badge">@item.SubjectName</span>
                        
                        <hr class="my-4">

                        <div class="d-grid gap-2">
                            <form asp-controller="Payment" asp-action="CreateDonation" method="post">
                                <input type="hidden" name="amount" value="5" />
                                <input type="hidden" name="tutor" value="@item.TutorName" />
                                <button type="submit" class="btn btn-success w-100"><i class="bi bi-piggy-bank"></i> Tip €5</button>
                            </form>
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="btn-group mt-2 w-100">
                                    <a asp-action="Edit" asp-route-id="@item.TutorId" class="btn btn-sm btn-outline-warning">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.TutorId" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
