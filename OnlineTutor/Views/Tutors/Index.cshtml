@model IEnumerable<OnlineTutor.DTOs.TutorDTO>

@{
    ViewData["Title"] = "Tutors";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-0">Our Expert Tutors</h1>
            <p class="text-muted">Learn from the best in the field.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
                <i class="bi bi-person-plus-fill me-2"></i>Add New Tutor
            </a>
        }
    </div>

    <div class="card border-0 shadow-sm mb-5" style="border-left: 5px solid #78C2AD !important; background-color: #f8fdfb;">
        <div class="card-body py-4">
            <div class="d-flex">
                <i class="bi bi-quote fs-1 text-primary me-3"></i>
                <div>
                    <p class="fs-5 fw-light italic mb-1">"@ViewBag.Quote"</p>
                    <footer class="blockquote-footer mt-1">@ViewBag.Author</footer>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 col-sm-6 mb-4">
                <div class="card h-100 shadow-sm tutor-card border-0">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px;">
                            <span class="fs-2 fw-bold">@item.TutorName.Substring(0, 1)</span>
                        </div>
                        
                        <h4 class="card-title fw-bold text-dark">@item.TutorName</h4>
                        <span class="subject-badge">@item.SubjectName</span>
                        
                        <hr class="my-4 opacity-25">

                        <div class="d-grid gap-2">
                            <form asp-controller="Payment" asp-action="CreateDonation" method="post">
                                <input type="hidden" name="amount" value="5" />
                                <input type="hidden" name="tutor" value="@item.TutorName" />
                                <button type="submit" class="btn btn-success rounded-pill shadow-sm">
                                    <i class="bi bi-currency-euro"></i> Tip €5
                                </button>
                            </form>
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="btn-group mt-2">
                                    <a asp-action="Edit" asp-route-id="@item.TutorId" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.TutorId" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
