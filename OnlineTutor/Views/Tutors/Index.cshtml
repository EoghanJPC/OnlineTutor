@model IEnumerable<OnlineTutor.DTOs.TutorDTO>

@{
    ViewData["Title"] = "Tutors";
}

<h1>Tutors</h1>

<div class="alert alert-info italic">
    <i class="bi bi-quote"></i> "@ViewBag.Quote" — <strong>@ViewBag.Author</strong>
</div>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TutorName)
            </th>
            <th>
                Subject
			</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TutorName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SubjectName)
            </td>
            <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.TutorId" class="btn btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.TutorId" class="btn btn-danger">Delete</a>
                    }
            </td>
            <td>
                 <form asp-controller="Payment" asp-action="CreateDonation" method="post" style="display:inline;">
                    <input type="hidden" name="amount" value="5" />
                    <input type="hidden" name="tutor" value="@item.TutorName" />
                    <button type="submit" class="btn btn-sm btn-outline-success">Tip €5</button>
                 </form>
            </td>
        </tr>
}
    </tbody>
</table>
